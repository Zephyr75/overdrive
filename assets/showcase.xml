<?xml version="1.0" ?>
<!-- Overdrive feature showcase. Geometry is baked into the Demo*.obj vertices
     (engine renders with an identity model matrix), so <position> is unused for
     static meshes. Up to 64 lights are supported in any order; every one of
     them casts a shadow if the atlas allocator can find it a tile, which it
     scores per frame from radius over distance to the camera. -->
<scene>
	<camera name="Camera">
		<type>persp</type>
		<position>0.0,-14.0,6.0</position>
		<yaw>0.0</yaw>
		<pitch>19.0</pitch>
		<fov>45.0</fov>
	</camera>

	<!-- Paving-stone ground: normal-mapped flat surface, catches both shadows -->
	<!-- The ground receives every shadow and casts none. With the whole scene
	     above it, a single-sided plane in the shadow map can only ever occlude
	     itself, and at the grazing angles a high light gives it that is acne
	     across the entire surface -->
	<mesh name="Ground">
		<position>0.0,0.0,0.0</position>
		<obj>DemoGround.obj</obj>
		<castsShadow>false</castsShadow>
	</mesh>

	<!-- Hero: metal Suzanne, normal-mapped, high specular -->
	<mesh name="Suzanne">
		<position>0.0,0.0,0.0</position>
		<obj>DemoSuzanne.obj</obj>
	</mesh>

	<!-- Polished chrome sphere: low Kd → skybox reflection dominates -->
	<mesh name="SphereChrome">
		<position>0.0,0.0,0.0</position>
		<obj>DemoSphereChrome.obj</obj>
	</mesh>

	<!-- Brick sphere: normal mapping on a curved surface -->
	<mesh name="SphereBrick">
		<position>0.0,0.0,0.0</position>
		<obj>DemoSphereBrick.obj</obj>
	</mesh>

	<!-- Wood cube: normal mapping on flat faces -->
	<mesh name="Cube">
		<position>0.0,0.0,0.0</position>
		<obj>DemoCube.obj</obj>
	</mesh>

	<!-- Nine lights, all nine shadowed: 6 spots + 2 point lights + 1 sun is
	     6 tiles of 1024 + 2x6 of 512 + 1 of 2048, 81% of the 4096 atlas. That is
	     the Part D allocator near its limit, and the point of the scene: every prop
	     stands in two or three overlapping coloured shadows.

	     Three placement rules, every one of them learnt by rendering the scene and
	     looking at it:

	     1. A light casts a *visible* shadow only when it is well above the props
	        and off to one side. Lights at eye level beside a prop throw their
	        shadows away horizontally, where no visible ground catches them.
	     2. Spots beat point lights for this. A spot contributes exactly zero
	        outside its cone, so its pool is a region where it dominates and its
	        shadow is most of the light lost. A point light lights everything a
	        little, which is a pedestal that no shadow can cut through.
	     3. Read the shadows by *hue*, not by brightness. fsMain ends on a Reinhard
	        curve, which compresses hard above 1: with several lights on one spot,
	        blocking one barely changes the luminance. Blocking a saturated one
	        leaves a strongly tinted shadow, which is unmistakable. Hence six
	        near-primary spots rather than six pastel ones.

	     XML position is (GLx, -GLz, GLy) because of the Blender->GL axis swap, and
	     XML direction is (shine.x, -shine.z, shine.y) of the GL shine vector, so a
	     lamp aimed straight down writes (0, 0, -1). -->

	<!-- Two spots per prop, from opposite sides, so each prop throws two coloured
	     shadows that cross. 26 deg from 5 units of height and 13 out is a long raking ellipse, and a
	     low light is what makes a shadow long enough to read as a silhouette -->

	<!-- red, GL (-10, 9, 6), front-left, onto the chrome sphere -->
	<light name="SpotRed">
		<type>spot</type>
		<position>-13.0,0.0,8.0</position>
		<direction>9.2,-0.4,-6.7</direction>
		<color>1.0,0.06,0.06</color>
		<diffuse>1.0</diffuse>
		<cone>24.0</cone>
		<coneBlend>0.25</coneBlend>
		<intensity>800000.0</intensity>
	</light>

	<!-- green, GL (-10, 9, -6), back-left, onto the chrome sphere -->
	<light name="SpotGreen">
		<type>spot</type>
		<position>-6.5,-11.3,8.0</position>
		<direction>2.7,10.9,-6.7</direction>
		<color>0.06,1.0,0.1</color>
		<diffuse>1.0</diffuse>
		<cone>24.0</cone>
		<coneBlend>0.25</coneBlend>
		<intensity>800000.0</intensity>
	</light>

	<!-- blue, GL (0, 9, 9), in front, onto Suzanne -->
	<light name="SpotBlue">
		<type>spot</type>
		<position>6.5,-11.3,8.0</position>
		<direction>-6.3,12.1,-6.5</direction>
		<color>0.1,0.25,1.0</color>
		<diffuse>1.0</diffuse>
		<cone>24.0</cone>
		<coneBlend>0.25</coneBlend>
		<intensity>800000.0</intensity>
	</light>

	<!-- amber, GL (0, 9, -9), behind, onto Suzanne. Its shadow is the only one
	     thrown toward the camera, so it never hides behind its own caster -->
	<light name="SpotAmber">
		<type>spot</type>
		<position>-6.5,11.3,8.0</position>
		<direction>6.7,-10.5,-6.5</direction>
		<color>1.0,0.55,0.05</color>
		<diffuse>1.0</diffuse>
		<cone>24.0</cone>
		<coneBlend>0.25</coneBlend>
		<intensity>800000.0</intensity>
	</light>

	<!-- cyan, GL (10, 9, 6), front-right, onto the brick sphere -->
	<light name="SpotCyan">
		<type>spot</type>
		<position>13.0,0.0,8.0</position>
		<direction>-9.2,-0.4,-6.8</direction>
		<color>0.05,0.9,1.0</color>
		<diffuse>1.0</diffuse>
		<cone>24.0</cone>
		<coneBlend>0.25</coneBlend>
		<intensity>800000.0</intensity>
	</light>

	<!-- magenta, GL (10, 9, -6), back-right, onto the brick sphere and the cube -->
	<light name="SpotMagenta">
		<type>spot</type>
		<position>6.5,11.3,8.0</position>
		<direction>-1.0,-9.3,-7.1</direction>
		<color>1.0,0.05,0.7</color>
		<diffuse>1.0</diffuse>
		<cone>24.0</cone>
		<coneBlend>0.25</coneBlend>
		<intensity>800000.0</intensity>
	</light>

	<!-- The two point lights, which is what puts 6-tile allocations in the atlas
	     beside the 1-tile ones. Kept dim: a point light lights the whole scene a
	     little, and that pedestal is what washes the spots' shadows out -->

	<!-- warm point, GL (0, 11, 0), straight overhead -> the short shadow directly
	     under each prop that the angled coloured ones fan out from -->
	<light name="PointWarm">
		<type>point</type>
		<position>0.0,0.0,11.0</position>
		<direction>0.0,0.0,-1.0</direction>
		<color>1.0,0.85,0.6</color>
		<diffuse>1.0</diffuse>
		<intensity>35000.0</intensity>
	</light>

	<!-- violet point, GL (7, 6, -10), behind the cube, the one prop no spot owns -->
	<light name="PointViolet">
		<type>point</type>
		<position>7.0,10.0,6.0</position>
		<direction>0.0,0.0,-1.0</direction>
		<color>0.65,0.3,1.0</color>
		<diffuse>1.0</diffuse>
		<intensity>55000.0</intensity>
	</light>

	<!-- sun -> the one ortho tile, and the only light with no falloff, so it is
	     also the only one whose shadow reaches the whole ground. Kept dim: at its
	     old 4.5 it drowned every coloured shadow and the scene read as having one -->
	<light name="Sun">
		<type>sun</type>
		<position>6.0,-5.0,12.0</position>
		<direction>-0.35,0.45,-1.0</direction>
		<color>1.0,0.98,0.92</color>
		<diffuse>1.0</diffuse>
		<intensity>0.5</intensity>
	</light>

</scene>
